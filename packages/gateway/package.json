{
  "name": "@ironclad/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express middleware for sender-constrained session tokens (DPoP + DBSC + mTLS)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "express": "^5"
  },
  "dependencies": {
    "@ironclad/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "express": "^5.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
